# الاعتماديات ومخرجات البناء — يُعاد توليدها بـ npm install و npm run build
node_modules/
dist/
dist-ssr/
.vite/

# ⚠️ الأسرار — لا تُرفع أبداً
# .env يحوي مفاتيح Firebase. رفعه يكشفها للعالم.
# انسخه يدوياً عند الانتقال لجهاز آخر (لن ينتقل مع git).
.env
.env.*
!.env.example
auth_users.json

# نسخ وأرشيفات ثقيلة — GitHub يرفض ملفاً أكبر من ١٠٠ ميجا
*.rar
*.zip
*.7z
*.backup
_نسخة_قبل_التأمين_*/

# سجلات
firebase-debug.log
firestore-debug.log
*.log
.firebase/

# نظام التشغيل والمحرّرات
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# مخرجات بناء قديمة لا تُبنى من هذا المصدر — كانت تُودَع بالخطأ فتُضخّم المستودع
# firebase_live_app: نسخة منشورة قديمة (مثل dist تماماً)
# electron-dist/electron: بقايا محاولة Electron المهجورة (القرار: QZ Tray لا Electron)
firebase_live_app/
electron-dist/
electron/
