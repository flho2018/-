# =========================================================================
#  نموذج متغيّرات البيئة — انسخه إلى ملف اسمه .env واملأ القيم
# =========================================================================
#  ⚠️ ملف .env الحقيقي لا يُرفع إلى المستودع (مستثنى في .gitignore).
#  فعند الانتقال إلى جهاز جديد لن ينتقل معك — انسخه يدوياً من الجهاز
#  القديم، وإلا لن يُقلع البرنامج إطلاقاً.
#
#  مصدر القيم: لوحة تحكّم Firebase ← إعدادات المشروع ← تطبيقات الويب
#  https://console.firebase.google.com/project/flower-house-8888d/settings/general
# =========================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=flower-house-8888d.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=flower-house-8888d
VITE_FIREBASE_STORAGE_BUCKET=flower-house-8888d.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
